{
  "description": "Blueprint for Craft Bridge marketplace",
  "collections": [
    {
      "name": "users",
      "description": "User accounts for artisans, customers, and buyers.",
      "securityRules": {
        "read": "request.auth != null && (request.auth.uid == documentId || resource.data.role == 'artisan')",
        "create": "request.auth != null && request.auth.uid == documentId",
        "update": "request.auth != null && request.auth.uid == documentId",
        "delete": "false"
      },
      "indexes": [
        { "fields": ["phone"], "queryType": "EQUALITY" }
      ]
    },
    {
      "name": "products",
      "description": "Handcrafted products added by artisans.",
      "securityRules": {
        "read": "request.auth != null",
        "create": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'artisan'",
        "update": "request.auth != null && resource.data.artisanId == request.auth.uid",
        "delete": "request.auth != null && resource.data.artisanId == request.auth.uid"
      },
      "indexes": [
        { "fields": ["artisanId"], "queryType": "EQUALITY" },
        { "fields": ["category"], "queryType": "EQUALITY" }
      ]
    },
    {
      "name": "enquiries",
      "description": "Enquiries made by buyers for artisan products.",
      "securityRules": {
        "read": "request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.artisanId == request.auth.uid)",
        "create": "request.auth != null",
        "update": "request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.artisanId == request.auth.uid)",
        "delete": "false"
      },
      "indexes": [
        { "fields": ["buyerId"], "queryType": "EQUALITY" },
        { "fields": ["artisanId", "createdAt"], "queryType": "ORDERED" }
      ]
    },
    {
      "name": "orders",
      "description": "Customer orders.",
      "securityRules": {
        "read": "request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.artisanId == request.auth.uid)",
        "create": "request.auth != null && resource.data.customerId == request.auth.uid",
        "update": "request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.artisanId == request.auth.uid)",
        "delete": "false"
      },
      "indexes": [
        { "fields": ["customerId"], "queryType": "EQUALITY" },
        { "fields": ["artisanId"], "queryType": "EQUALITY" }
      ]
    }
  ]
}
